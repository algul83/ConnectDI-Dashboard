# ConnectDI Dashboard - Streamlit Secrets
#
# 이 파일은 템플릿입니다. 실제 비밀값을 채워서 secrets.toml로 저장하세요.
# 로컬: .streamlit/secrets.toml (gitignore됨)
# 배포: Streamlit Cloud → App settings → Secrets 에 동일 내용 붙여넣기

# ───────────────────────────────────────────────
# 1. 접근 비밀번호 (사내 직원 공유용)
# ───────────────────────────────────────────────
app_password = "여기에-사내-비밀번호-입력"

# ───────────────────────────────────────────────
# 2. Google Drive 폴더 ID
# ───────────────────────────────────────────────
DRIVE_FOLDER_DI_KEYWORD = "1tsEwHFoQWIIBCVNtCeNKrVjbXAiFGtXK"
DRIVE_FOLDER_PLUS_KEYWORD = "1rYLAKFUNYp7uAf3bNqx4bafZuf3jQDQ7"

# ───────────────────────────────────────────────
# 3. Google Service Account (Drive 읽기 권한)
#    service-account.json의 내용을 아래 형식으로 복사
# ───────────────────────────────────────────────
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
여기에-여러줄-private-key-내용
-----END PRIVATE KEY-----
"""
client_email = "your-sa@your-project.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"
